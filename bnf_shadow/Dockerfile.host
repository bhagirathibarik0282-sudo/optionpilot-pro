# Opt-in only: select this path explicitly after reviewing the SHADOW release.
FROM node:22.23.4-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY bnf_shadow/requirements.txt /tmp/bnf-requirements.txt
RUN python3 -m venv /opt/bnf-venv \
    && /opt/bnf-venv/bin/pip install --no-cache-dir -r /tmp/bnf-requirements.txt
ENV PATH="/opt/bnf-venv/bin:${PATH}" PYTHONUNBUFFERED=1
COPY package*.json ./
RUN npm install --omit=dev --no-package-lock
COPY . .
EXPOSE 8080
CMD ["npm", "start"]
