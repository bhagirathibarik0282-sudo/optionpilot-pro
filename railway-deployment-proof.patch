+    status: "RUNNING",
+    deploymentId: process.env.RAILWAY_DEPLOYMENT_ID?.trim() || null,
+    gitCommitSha: process.env.RAILWAY_GIT_COMMIT_SHA?.trim() || null,
+    gitBranch: process.env.RAILWAY_GIT_BRANCH?.trim() || null,
+    serviceName: process.env.RAILWAY_SERVICE_NAME?.trim() || null,
+    environmentName: process.env.RAILWAY_ENVIRONMENT_NAME?.trim() || null,
+    replicaId: process.env.RAILWAY_REPLICA_ID?.trim() || null,
+    uptimeSeconds: Math.floor(process.uptime()),
+    systemHealth: health.overallStatus,
+    generatedAt: new Date().toISOString(),
+    secretsExposed: false,
+    readOnly: true,
+  });
+});
