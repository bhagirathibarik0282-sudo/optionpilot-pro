+// ============== RAILWAY DEPLOYMENT IDENTITY PROOF (read-only) ==============
+// Additive observability only. Reuses the existing System Health engine and
+// exposes only Railway-provided non-secret deployment metadata. It never reads
+// application secrets/tokens and has no scoring, trading, broker, DB-write,
+// GitHub-push, Railway-deploy, AI, or order-execution side effects.
+app.get("/api/system/deployment-proof", (c) => {
+  const health = computeSystemHealth();
+  return c.json({
